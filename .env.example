# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so it must never
# hold a real value. Nothing here is required: Pharos generates, gates, and runs its
# model-free measurements with none of it set.
#
#   cp .env.example .env
#
# Nothing in the package reads `.env` automatically. These are environment variables,
# and the file exists to record which ones matter and what each is for.

# --- Hugging Face -----------------------------------------------------------------
# Only needed to fetch model weights, which `scripts/train_adapter.py` and the cluster
# jobs do. Everything Pharos downloads is public, so an unauthenticated run works --
# it is merely rate limited, and a throttled download inside a GPU allocation burns
# the allocation rather than failing fast. A 24-task array is 24 chances to hit that.
#
# Fine-grained, READ-only. Pharos never uploads, so a write-scoped token grants
# strictly more than it needs. Prefer `hf auth login`, which writes
# `$HF_HOME/token` with 0600 rather than leaving the secret in a shell environment
# where every child process inherits it.
HF_TOKEN=

# Where model weights are cached. Point this at a path with room and persistence: on
# the cluster it must be the shared home filesystem, not a node-local temp dir, or
# every job refetches several gigabytes somebody else has already paid for.
HF_HOME=

# --- Observability ----------------------------------------------------------------
# Unset, every span is a no-op and measurements still emit structured JSON on stdout.
# Set, traces and metrics are exported. `docker compose up -d` brings up a collector,
# Jaeger and Prometheus to point at. What degrades without this is the export, never
# the number.
PHAROS_OTLP_ENDPOINT=

# DEBUG surfaces the routine per-item metrics that are hidden at INFO by design --
# `record_routine` exists so a sweep does not bury its own result under thirty
# identical corpus lines.
PHAROS_LOG_LEVEL=

# --- Model backend ----------------------------------------------------------------
# Where Ollama is listening, if not the default. `pharos.attribute` is the only module
# that contacts a model.
PHAROS_ENDPOINT=

# --- Cluster ----------------------------------------------------------------------
# Overrides for `scripts/sync_cluster.sh`. It fetches a commit rather than copying
# files, so artifacts produced there can name the code that produced them.
PHAROS_CLUSTER_HOST=
PHAROS_CLUSTER_PATH=
