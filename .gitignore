__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
dist/
build/
*.egg-info/
out/
site/
export/
COMMITS.md

# Trainer checkpoints and optimizer state, written per job under adapter-out/<job id>.
# Only GPU machines produce these, which is why the directory was never ignored: it
# has never once existed on the machine where commits are made.
adapter-out/

# Scratch JSON at the repo root only. Measurement artifacts live in results/ and
# are tracked on purpose: a table in a paper needs a committed file behind it.
/*.json

# Credentials. Nothing here has ever been committed, and this exists so that stays
# true by construction rather than by remembering. Tokens belong in the environment
# or in the Hugging Face CLI's own store, never in the tree.
.env
.env.*
!.env.example
*.token
secrets/

# WSL writes this alternate-data-stream sidecar next to anything saved from Windows.
*:Zone.Identifier

# The frozen explorer. Generated from src/pharos/static/index.html plus a bundle
# of endpoint responses, and rebuilt in the docs workflow before Zensical runs.
# Committing it would put a 1.2 MB generated blob in every diff that touches the
# page, and would let the bundle drift from the code that produced it.
docs/explorer/

# Written by `make ci` to detect a tree edited while the gate was running.
.gate-fingerprint
